# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and the publishable/anon key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import outside src/server/, never log.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google APIs -- SERVER ONLY
# ---------------------------------------------------------------------------
# One key with the Places API (New) and the Geocoding API enabled.
# Restrict it in Cloud Console to those two APIs.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Shared secret that pg_cron presents to POST /api/jobs/tick.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=

# Work-slice budget in milliseconds. The worker stops claiming new pages once
# this much wall clock has elapsed and releases its lease cleanly.
# This is NOT a platform limit -- correctness does not depend on it. A shorter
# slice simply means more, smaller ticks. Keep it well below the platform's
# function timeout (Vercel Hobby with fluid compute: 300s; legacy: 60s).
WORKER_SLICE_MS=25000

# Seconds before an unheartbeated lease is considered dead and reclaimable.
WORKER_LEASE_SECONDS=90

# Maximum tiles a single tick will process before releasing, regardless of time.
WORKER_MAX_TILES_PER_TICK=25

# Optional latency optimisation: after a tick ends with work remaining, the
# worker pings itself so the next slice starts immediately instead of waiting
# for the next pg_cron beat. pg_cron alone is sufficient; leave this off unless
# you want faster runs.
WORKER_SELF_CHAIN=false

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute origin, used to build the self-chain URL and the pg_cron target.
NEXT_PUBLIC_APP_URL=http://localhost:3000
